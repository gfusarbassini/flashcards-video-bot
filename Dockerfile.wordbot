FROM python:3.11-slim

# Installa dipendenze di sistema
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libcairo2-dev \
    libgirepository1.0-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copia e installa requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# PRE-WARM: Importa tutte le librerie pesanti al build time
# Questo crea il bytecode cache e velocizza gli import successivi
RUN python -c "
import pandas
import requests
import cairosvg
from google import genai
from gtts import gTTS
from pydub import AudioSegment
from moviepy.editor import ImageClip, concatenate_videoclips
import numpy as np
from PIL import Image
from concurrent.futures import ThreadPoolExecutor
print('✅ Tutte le librerie pre-caricate')
"

# Copia il codice
COPY . /workspace
WORKDIR /workspace

# Pre-crea le directory necessarie
RUN mkdir -p flashcards/ASSET

# Entrypoint per esecuzione diretta
ENTRYPOINT ["python", "append_word.py"]
