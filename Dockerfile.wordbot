# Base Python
FROM python:3.12-slim

# ── System dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    imagemagick \
    wget \
    && rm -rf /var/lib/apt/lists/*

# ── Fix ImageMagick policy
RUN sed -i 's/domain="coder" rights="none"/domain="coder" rights="read|write"/' \
    /etc/ImageMagick-6/policy.xml || true

# ── Python dependencies
COPY requirements.wordbot.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.wordbot.txt

# ── Font
RUN mkdir -p /usr/share/fonts/truetype/unbounded \
    && wget -O /usr/share/fonts/truetype/unbounded/Unbounded.ttf \
       "https://github.com/google/fonts/raw/main/ofl/unbounded/Unbounded%5Bwght%5D.ttf" \
    && fc-cache -f

# ── Workdir
WORKDIR /app
COPY . .

# Default command (non obbligatorio)
CMD ["python3", "append_word.py"]
