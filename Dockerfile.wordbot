# ────────────── Base Python stabile ──────────────
FROM python:3.12-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ────────────── System dependencies con cache ──────────────
# aggiorniamo apt solo se necessario
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    imagemagick \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    wget \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# ────────────── Fix ImageMagick security policy ──────────────
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
      sed -i 's/domain="coder" rights="none"/domain="coder" rights="read|write"/' /etc/ImageMagick-6/policy.xml ; \
    fi

# ────────────── Font custom (Unbounded) ──────────────
RUN mkdir -p /usr/share/fonts/truetype/unbounded \
 && wget -q -O /usr/share/fonts/truetype/unbounded/Unbounded.ttf \
    https://github.com/google/fonts/raw/main/ofl/unbounded/Unbounded%5Bwght%5D.ttf \
 && fc-cache -f -v

# ────────────── Workdir e copy requirements separato ──────────────
WORKDIR /app
COPY requirements.wordbot.txt .

# ────────────── Install Python dependencies con cache pip ──────────────
RUN pip install --upgrade pip \
 && pip install --no-cache-dir -r requirements.wordbot.txt

# ────────────── Copia tutto il resto del codice ──────────────
COPY . .

# Default command
CMD ["python3", "append_word.py"]
